<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/page_padding" tools:context=".KeysFragment" tools:theme="@style/Theme.PassPulse">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_keys" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/latest_passwords" android:textColor="@color/text_secondary" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/keysList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="18dp" android:layout_weight="1" tools:listitem="@layout/item_key" />
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/empty_history" android:textColor="@color/text_secondary" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="16dp" android:text="@string/auto_delete_note" android:textColor="@color/text_secondary" android:textSize="13sp" />
</LinearLayout>
